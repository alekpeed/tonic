root = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true
ktlint_code_style = ktlint_official
# Jetpack Compose functions are conventionally PascalCase (they read as
# widgets, not verbs). This is ktlint's documented opt-out for that case.
ktlint_function_naming_ignore_when_annotated_with = Composable
