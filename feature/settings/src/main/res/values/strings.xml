    <string name="settings_saved_session_heading">Saved session</string>
    <string name="settings_discard_session">Discard saved session</string>
    <string name="settings_discard_session_body">If a saved practice session keeps bringing back a problem, discard it here. Your calibration and skill progress are kept — only the unfinished session goes.</string>
