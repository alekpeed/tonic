<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- docs/08-UI-SPEC.md §7: "Session completion acknowledgment: brief, factual." No fanfare. -->
    <string name="practice_session_complete">Session complete.</string>
    <!-- Stage name, shown persistently on the practice screen - docs/11-ONBOARDING-CLARITY.md §9.1. -->
    <string name="practice_stage_name">Practice</string>

    <string name="practice_replay">Replay</string>
    <string name="practice_skip">Skip</string>

    <!-- Caption under the phase indicator, changes with playback phase - unlike the phase indicator
         itself (deliberately non-verbal per docs/08-UI-SPEC.md §4), this says in words what's
         happening and what to do, on every item, every time. -->
    <string name="practice_phase_reference">Setting up \"home\" — more notes than your buttons. That\'s normal.</string>
    <string name="practice_phase_target">One note, alone — this is the question.</string>
    <string name="practice_phase_awaiting_answer">Tap where it sits, relative to home. Not sure? Guess.</string>

    <!-- Axis-change announcements - docs/11-ONBOARDING-CLARITY.md §9.3: "a plain, short statement:
         what changed, framed as forward progress, not as an unexplained shift." One line, non-blocking,
         shown on the item where the change lands. Every axis in 03-CURRICULUM.md §5.3 is covered, in
         both directions: a decrease is support being added back and is never framed as a demotion
         (08-UI-SPEC.md §7 prohibits loss framing). No level numbers - they'd mean nothing to the user. -->
    <string name="practice_axis_cadence_harder">Fewer chords now — you\'re ready for less support.</string>
    <string name="practice_axis_cadence_easier">More of the chord setup back for a bit.</string>
    <string name="practice_axis_timbre_harder">New instrument sounds from here.</string>
    <string name="practice_axis_timbre_easier">Back to steadier instrument sounds for a bit.</string>
    <string name="practice_axis_register_harder">Notes will range wider now.</string>
    <string name="practice_axis_register_easier">Narrowing the range back for a bit.</string>
    <string name="practice_axis_octave_harder">The note may now land in a different octave.</string>
    <string name="practice_axis_octave_easier">Keeping the note nearer home for a bit.</string>
    <string name="practice_axis_tempo_harder">Slightly quicker from here.</string>
    <string name="practice_axis_tempo_easier">Easing the pace back for a bit.</string>
    <string name="practice_axis_key_harder">More keys in the mix now.</string>
    <string name="practice_axis_key_easier">Fewer keys for a bit.</string>

    <!-- Resume offer - docs/10-TESTING.md §11. Plain and factual; picking up where you left off is
         presented as an option, never as something you owe the app (docs/08-UI-SPEC.md §7). -->
    <string name="practice_resume_title">You have a session in progress.</string>
    <string name="practice_resume_body">You can pick up where you left off, or start a new one.</string>
    <string name="practice_resume_continue">Continue</string>
    <string name="practice_resume_start_fresh">Start a new session</string>

    <!-- Paused after an interruption - docs/06-AUDIO-ENGINE.md §8. States what happened, no blame. -->
    <string name="practice_paused_title">Paused.</string>
    <string name="practice_paused_body">That note wasn\'t scored. Continue whenever you\'re ready.</string>
    <string name="practice_paused_continue">Continue</string>
</resources>
