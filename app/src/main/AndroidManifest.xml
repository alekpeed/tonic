<?xml version="1.0" encoding="utf-8"?>
<!--
    No network permission of any kind, deliberately. See CLAUDE.md §1 and §7:
    Phase 1 is fully offline. docs/09-BUILD-PLAN.md Stage 10 verifies this
    absence explicitly, and docs/10-TESTING.md's manual checklist covers
    airplane-mode operation.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The only permission this app declares. Optional in the strict sense: every
        module is fully playable without it, singing is off until the learner turns
        it on, and denial is an ordinary state rather than an error
        (docs/30-PHASE-3-SPEC.md 6.1). Declared with maxSdkVersion absent on purpose
        - it is a runtime permission on every SDK this app supports, requested only
        at the moment the learner opts in, never at install and never at launch.

        Captured audio is never written anywhere. It exists in memory for one
        attempt and is discarded (docs/30-PHASE-3-SPEC.md 7).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".TonicApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tonic">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Tonic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
